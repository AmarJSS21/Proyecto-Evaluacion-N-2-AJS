<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center_horizontal"
    android:background="#F5F5F5">

    <Button
        android:id="@+id/btnVolver"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:text="VOLVER ATRÁS" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Registrar Incidencia"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp" />

    <EditText
        android:id="@+id/etTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Título de la incidencia"
        android:inputType="text"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/etDescripcion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Descripción corta"
        android:inputType="textMultiLine"
        android:lines="3"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvCoordenadas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Coordenadas: Aún no obtenidas"
        android:textColor="#555555"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnObtenerUbicacion"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="OBTENER UBICACIÓN GPS"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnGuardarFirebase"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="GUARDAR EN FIREBASE"
        android:backgroundTint="#4CAF50"
        android:textColor="#FFFFFF" />

</LinearLayout>